{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
